# --- Servidor ---
NODE_ENV=development
PORT=8100

# --- Base de datos (propia, separada de Horom) ---
# Usa DATABASE_URL o las variables DB_* (DATABASE_URL tiene prioridad).
# El usuario NO debe ser superuser ni tener BYPASSRLS (ver README).
# DATABASE_URL=postgres://neuron_app:cambiar@localhost:5432/neuronpos_core
DB_HOST=localhost
DB_PORT=5432
DB_NAME=neuronpos_core
DB_USER=neuron_app
DB_PASSWORD=cambiar
DB_POOL_MAX=10
# true = no arrancar si el usuario de BD se salta RLS (en produccion siempre aplica)
REQUIRE_RLS_ROLE=false

# --- Autenticacion ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-largo
JWT_EXPIRES_IN=12h
# Sesiones de clientes del portal de pedidos en linea
CUSTOMER_JWT_EXPIRES_IN=30d
LOGIN_RATE_LIMIT=20
# Sitio y portal publicos: requests por IP y restaurante cada 15 min
PUBLIC_RATE_LIMIT=600
# Pedidos en linea por IP y restaurante cada hora
ORDER_RATE_LIMIT=20

# --- Multi-restaurante ---
# Dominio base: cada restaurante vive en <slug>.<PLATFORM_DOMAIN>
PLATFORM_DOMAIN=localhost
# Sitio de la plataforma para regresar de Clip en NeuronPOS Delivery (por omision https://<PLATFORM_DOMAIN>).
# PLATFORM_SITE_URL=https://neuronpos.app
RESERVED_SUBDOMAINS=www,app,api,admin,panel,static,cdn,mail
# Permite elegir restaurante con el header X-Restaurant-Slug (por defecto
# true fuera de produccion).
ALLOW_SLUG_HEADER=true
# Dias de prueba al crear un restaurante en estado "trial"
TRIAL_DAYS=14

# --- CORS (separados por coma; vacio = cualquier origen en desarrollo) ---
CORS_ORIGINS=

# --- Fase 3: cobro con Clip ---
# URL publica del backend (Clip manda aqui los webhooks):
#   plataforma:   <PUBLIC_API_URL>/api/webhooks/clip/plataforma
#   restaurante:  <PUBLIC_API_URL>/api/webhooks/clip/r/<slug o id del restaurante>
PUBLIC_API_URL=http://localhost:8100
# A donde regresa Clip al cliente / al restaurante despues de pagar.
# {slug} y {domain} se reemplazan; un dominio propio usa https://<dominio>.
# En desarrollo: http://{slug}.localhost:5173
RESTAURANT_URL_TEMPLATE=https://{slug}.{domain}

# Cuenta de Clip de la PLATAFORMA (NeuronPOS cobra la mensualidad a los
# restaurantes). Se obtienen en https://dashboard.payclip.com (Desarrolladores).
# Clip solo tiene ambiente de produccion: prueba con montos pequenos.
CLIP_API_KEY=
CLIP_SECRET_KEY=
# Secreto para validar la firma de los webhooks (x-clip-signature). Si se
# define, un webhook con firma invalida se rechaza.
CLIP_WEBHOOK_SECRET=
# CLIP_API_URL=https://api.payclip.com

# Llave para cifrar (AES-256-GCM) las credenciales de Clip de cada restaurante.
# 32 bytes en base64 o hex. Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NO la cambies despues: las credenciales guardadas ya no se podrian leer.
PAYMENT_SECRETS_KEY=

# Zona horaria de las fechas de cobro (dia de cobro, vencimiento y gracia).
BILLING_TIMEZONE=America/Mexico_City
# true = generar facturas, marcar vencidas y suspender automaticamente (cada hora).
BILLING_AUTO=true
# Jobs en segundo plano (cobro, conciliacion con Clip, pedidos sin pagar).
JOBS_ENABLED=true

# Correo saliente (recuperar contrasena, avisos de pedidos y de cobro).
# Sin SMTP_HOST los correos solo se escriben en el log.
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true   (por defecto true si el puerto es 465)
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NeuronPOS <no-reply@neuronpos.app>

# Notificaciones push (opcional): si no se ponen, las llaves se generan solas
# y se guardan cifradas en la base. Generalas con: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:soporte@neuronpos.app

# Bot de WhatsApp (modulo whatsapp): app de Meta de la plataforma. El webhook
# es https://<api>/api/webhooks/whatsapp para todos los restaurantes.
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
